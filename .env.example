# ============================================================
# StockMind AI — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Upstox API Credentials ---
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:8000/api/auth/callback
UPSTOX_ANALYTICS_TOKEN=eyJ0eXAiOiJKV1QiLCJrZXlfaWQiOiJza192MS4wIiwiYWxnIjoiSFMyNTYifQ.eyJzdWIiOiJCQjA0OTQiLCJqdGkiOiI2YWJkZjkzYzk4ZGM4YjQzZThkZjAxYzQiLCJpc011bHRpQ2xpZW50IjpmYWxzZSwiaXNQbHVzUGxhbiI6dHJ1ZSwiaXNFeHRlbmRlZCI6dHJ1ZSwiaWF0IjoxNzkwODM1MDA0LCJpc3MiOiJ1ZGFwaS1nYXRld2F5LXNlcnZpY2UiLCJleHAiOjE4MjI0MjgwMDB9.HH7PUaqXvrevjNn7rKbL5YpOv0qlalOn7GSfO9ehkOI

# --- Database ---
DATABASE_URL=postgresql+asyncpg://stockmind:stockmind_secret@localhost:5432/stockmind
DATABASE_URL_SYNC=postgresql://stockmind:stockmind_secret@localhost:5432/stockmind
POSTGRES_USER=stockmind
POSTGRES_PASSWORD=stockmind_secret
POSTGRES_DB=stockmind

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_URL=redis://localhost:6379/1
REDIS_CELERY_URL=redis://localhost:6379/2

# --- Security ---
JWT_SECRET=change-this-to-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440
ENCRYPTION_KEY=change-this-to-a-fernet-key

# --- Application ---
APP_NAME=StockMind AI
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# --- ML ---
MODEL_REGISTRY_PATH=./model_registry
MODEL_VERSION=v1.0.0

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json
